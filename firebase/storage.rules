rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isOwnTeacherWorkspace(workspaceId) {
      return signedIn() && workspaceId == "teacher-workspace-" + request.auth.uid;
    }

    function isPlanMember(workspaceId, planId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/plans/$(planId)/members/$(request.auth.uid));
    }

    function canUsePlanStorage(workspaceId, planId) {
      return isOwnTeacherWorkspace(workspaceId)
        || isWorkspaceMember(workspaceId)
        || isPlanMember(workspaceId, planId);
    }

    match /workspaces/{workspaceId}/plans/{planId}/{allPaths=**} {
      allow read: if canUsePlanStorage(workspaceId, planId);
      allow create, update: if canUsePlanStorage(workspaceId, planId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if canUsePlanStorage(workspaceId, planId);
    }
  }
}
